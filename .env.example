# Copy to .env and fill in. Everything works WITHOUT API keys (token-level
# signals from the free DexScreener API + a clearly-labelled simulated wallet
# feed). Keys/passwords below unlock real wallet data and protect the dashboard.

# --- Dashboard login (HTTP basic auth) ---------------------------------------
# Leave DASHBOARD_PASSWORD empty for no login (fine for localhost-only dev).
# STRONGLY set a password before exposing the dashboard on a public server —
# the dashboard includes a Reset button that wipes the paper portfolio.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Wallet intelligence (optional) ------------------------------------------
# Helius (https://helius.dev) — real top-holder / whale concentration data.
HELIUS_API_KEY=
# Birdeye (https://birdeye.so) — optional alternative wallet/price provider.
BIRDEYE_API_KEY=

# --- Networking --------------------------------------------------------------
# Use 0.0.0.0 when running in Docker / on a server; 127.0.0.1 for local only.
MEMEBOT_HOST=127.0.0.1
MEMEBOT_PORT=8000

# Docker only: which host address the dashboard is published on.
#   127.0.0.1 (default) = private to the droplet (reach it via SSH tunnel)
#   0.0.0.0             = exposed on the droplet's PUBLIC IP (set a password +
#                         a firewall first!). Lets you open http://DROPLET_IP:8000
BIND_ADDR=127.0.0.1
# Where the SQLite database lives (the Docker image defaults this to /data).
# MEMEBOT_DB=/data/memeradar.db

# Override the CA bundle used for outbound HTTPS (leave empty for the default).
# SSL_CERT_FILE=
