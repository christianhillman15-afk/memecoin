# Copy to .env and fill in. Everything works WITHOUT API keys (token-level
# signals from the free DexScreener API + a clearly-labelled simulated wallet
# feed). Keys/passwords below unlock real wallet data and protect the dashboard.

# --- Dashboard login (password only) -----------------------------------------
# You log in with just this password — there is no username. Leave it empty for
# no login (fine for localhost-only dev). STRONGLY set one before exposing the
# dashboard on a public server — it has a Reset button that wipes the portfolio.
DASHBOARD_PASSWORD=

# --- Telegram bot (optional) -------------------------------------------------
# Get phone alerts + query/control the desk from Telegram. Leave the token empty
# to disable. Setup: message @BotFather -> /newbot -> copy the token below.
# Then DM your bot and send /start; it replies with your numeric chat id — put
# that in TELEGRAM_CHAT_IDS (comma-separated for multiple people).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Who may run control commands (pause/resume/scan/reset). Defaults to the read
# list above if left empty. Must be a subset of TELEGRAM_CHAT_IDS.
TELEGRAM_ADMIN_CHAT_IDS=
# Short secret required to type after /reset (destructive). Empty => /reset uses
# a two-step confirm instead.
TELEGRAM_RESET_TOKEN=

# --- Wallet intelligence (optional) ------------------------------------------
# Helius (https://helius.dev) — real top-holder / whale concentration data.
HELIUS_API_KEY=
# Birdeye (https://birdeye.so) — optional alternative wallet/price provider.
BIRDEYE_API_KEY=

# --- Launchpad (optional) ----------------------------------------------------
# The Launchpad streams every brand-new pump.fun coin and tracks creators with
# NO key (the free new-coin + migration streams). A funded PumpPortal API key
# (https://pumpportal.fun, fund it with >= 0.02 SOL) ADDITIONALLY unlocks the
# per-trade buyer stream, enabling real per-wallet (not just per-creator)
# auto-discovery. Leave empty to run the free version.
PUMPPORTAL_API_KEY=

# --- Networking --------------------------------------------------------------
# Use 0.0.0.0 when running in Docker / on a server; 127.0.0.1 for local only.
MEMEBOT_HOST=127.0.0.1
MEMEBOT_PORT=8000

# Docker only: which host address the dashboard is published on.
#   127.0.0.1 (default) = private to the droplet (reach it via SSH tunnel)
#   0.0.0.0             = exposed on the droplet's PUBLIC IP (set a password +
#                         a firewall first!). Lets you open http://DROPLET_IP:8000
BIND_ADDR=127.0.0.1
# Where the SQLite database lives (the Docker image defaults this to /data).
# MEMEBOT_DB=/data/memeradar.db

# Override the CA bundle used for outbound HTTPS (leave empty for the default).
# SSL_CERT_FILE=
