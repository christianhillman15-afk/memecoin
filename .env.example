# Copy to .env and fill in to unlock real on-chain wallet intelligence.
# Everything works WITHOUT these keys (token-level signals from the free
# DexScreener API + a clearly-labelled simulated wallet feed for the demo).

# Helius (https://helius.dev) — used for real top-holder / wallet trade data.
HELIUS_API_KEY=

# Birdeye (https://birdeye.so) — optional alternative wallet/price provider.
BIRDEYE_API_KEY=

# Override the CA bundle used for outbound HTTPS (leave empty for the default).
# SSL_CERT_FILE=

# Host / port for the dashboard.
MEMEBOT_HOST=127.0.0.1
MEMEBOT_PORT=8000
